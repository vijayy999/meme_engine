<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#222222"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/ivTagPreview"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/meme_thumbnail" />

    <!-- Normal Tags Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/normal_tags_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#E6E0E9"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="none"
        android:hint="@string/normal_tags_hint"
        android:textColorHint="#808080"
        android:textColor="#FFFFFF"
        android:inputType="text"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <!-- Hashtags (#) Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hashtags_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#D0BCFF"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etHashtags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="none"
        android:hint="@string/hashtags_hint"
        android:textColorHint="#808080"
        android:textColor="#D0BCFF"
        android:inputType="text"
        android:singleLine="true"
        android:layout_marginBottom="20dp" />

    <!-- Action 1: Copy to Destination -->
    <Button
        android:id="@+id/btnDestination"
        style="?attr/materialButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/copy_to_destination"
        android:backgroundTint="#D0BCFF"
        android:textColor="#381E72"
        android:layout_marginBottom="10dp" />

    <!-- Actions 2 & 3: Cancel and Save -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textColor="#E6E0E9"
            app:strokeColor="#79747E"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSave"
            style="?attr/materialButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/save"
            android:backgroundTint="#D0BCFF"
            android:textColor="#381E72" />

    </LinearLayout>

</LinearLayout>
