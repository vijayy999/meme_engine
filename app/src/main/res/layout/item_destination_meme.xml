<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/meme_corner_radius"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivMemeThumbnail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:background="@color/surface_card"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/meme_thumbnail" />

        <View
            android:id="@+id/vSelectionOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#808B5CF6"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/ivMemeThumbnail"
            app:layout_constraintEnd_toEndOf="@+id/ivMemeThumbnail"
            app:layout_constraintStart_toStartOf="@+id/ivMemeThumbnail"
            app:layout_constraintTop_toTopOf="@+id/ivMemeThumbnail" />

        <ImageView
            android:id="@+id/ivCheckmark"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_tag_done"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/ivMemeThumbnail"
            app:layout_constraintEnd_toEndOf="@+id/ivMemeThumbnail"
            app:layout_constraintStart_toStartOf="@+id/ivMemeThumbnail"
            app:layout_constraintTop_toTopOf="@+id/ivMemeThumbnail"
            android:contentDescription="@string/tag_status_badge" />

        <ImageView
            android:id="@+id/ivDeleteSingle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="4dp"
            android:background="@drawable/ic_tag_none"
            android:padding="4dp"
            app:layout_constraintEnd_toEndOf="@+id/ivMemeThumbnail"
            app:layout_constraintTop_toTopOf="@+id/ivMemeThumbnail"
            android:contentDescription="Delete image" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
