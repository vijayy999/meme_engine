<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Theme for the entire application -->
    <style name="Base.Theme.Meme_engine" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#121212</item>
        <item name="colorSurface">#1E1E1E</item>
        <item name="colorPrimary">#D0BCFF</item>
        <item name="colorOnPrimary">#381E72</item>
        <item name="colorContainer">#2B2930</item>
        <item name="colorOnContainer">#E6E0E9</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#CAC4D0</item>
        <item name="dialogTheme">@style/CustomDarkDialog</item>
    </style>

    <style name="Theme.Meme_engine" parent="Base.Theme.Meme_engine" />

    <style name="CustomDarkDialog" parent="Theme.Material3.Dark.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
